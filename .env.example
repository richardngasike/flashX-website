# Public address of this website (used for link previews). Example: https://flashx.co.ke
NEXT_PUBLIC_SITE_URL=

# Optional: serve the APK from elsewhere (e.g. a GitHub release) instead of
# public/downloads/flashx.apk. Use when the file is too large for your host.
NEXT_PUBLIC_APK_URL=
# Optional, only with NEXT_PUBLIC_APK_URL: size in bytes and SHA-256 of that file.
NEXT_PUBLIC_APK_SIZE=
NEXT_PUBLIC_APK_SHA256=
